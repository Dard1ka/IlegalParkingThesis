# ══════════════════════════════════════════════════════════════
# Environment variables untuk docker-compose
# Copy file ini ke `.env` lalu sesuaikan kebutuhan.
#   cp .env.example .env
#
# Semua nilai di bawah adalah DEFAULT (sama dengan tanpa file .env).
# Arti lengkap tiap variabel PARKING_*: backend/README.md bagian
# "Environment Variables". Setelah mengubah .env: docker compose up -d
# ══════════════════════════════════════════════════════════════

# ── TTS / audio ──────────────────────────────────────────────
# Container tidak punya perangkat audio, jadi default-nya driver "dummy"
# (tanpa suara) dan TTS dimatikan. Kalau ENABLE_TTS=true dengan driver
# dummy, MP3 tetap diminta ke Edge-TTS lalu "diputar" tanpa terdengar.
#
# Mengaktifkan audio sungguhan (host Linux):
#   1. teruskan audio host ke container (lihat docker/README.md),
#   2. ganti SDL_AUDIODRIVER ke pulse atau alsa,
#   3. set ENABLE_TTS=true.
#
# dummy  = silent (default, aman di mana saja)
# alsa   = Linux host dengan ALSA
# pulse  = Linux host dengan PulseAudio (perlu mount socket)
SDL_AUDIODRIVER=dummy
ENABLE_TTS=false

# ── Model ────────────────────────────────────────────────────
# Path RELATIF terhadap root project (tanpa "/" di depan). File/folder ini
# otomatis di-mount read-only ke container oleh docker-compose.yml.
# Image hanya berisi runtime untuk model .pt; model hasil export (.onnx)
# butuh paket yang tidak ada di image (lihat docker/README.md).
PARKING_VEHICLE_MODEL=best.pt
PARKING_TRIANGLE_MODEL=triangle.pt

# ── Inferensi ────────────────────────────────────────────────
# Ukuran input model (piksel)
PARKING_VEHICLE_IMGSZ=960
PARKING_TRIANGLE_IMGSZ=640
# Khusus file video: detik video yang dimajukan per tick (bilangan bulat >= 1)
PARKING_TICK_STEP=1
# Konfigurasi tracker. Default = "botsort.yaml" (BoT-SORT bawaan Ultralytics).
# Boleh juga "bytetrack.yaml" (bawaan Ultralytics), atau "botsort_static.yaml"
# (file bawaan backend, BoT-SORT tanpa GMC). Yang terakhir itu OPT-IN: sedikit
# lebih ringan, tetapi bisa mengubah logical id / durasi sebagian kendaraan.
PARKING_TRACKER=botsort.yaml

# ── Jaringan ─────────────────────────────────────────────────
# Origin dashboard yang boleh memanggil API, dipisah koma. Kalau dashboard
# dibuka dari perangkat lain di jaringan, tambahkan http://<IP-host>:5173
PARKING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Alamat backend yang di-bake ke bundle frontend SAAT BUILD (perlu
# `docker compose build frontend` setelah diubah).
# Kosong = otomatis http://<hostname halaman dashboard>:8000
VITE_API_BASE=

# ── Lain-lain ────────────────────────────────────────────────
# Timezone untuk logging
TZ=Asia/Jakarta
