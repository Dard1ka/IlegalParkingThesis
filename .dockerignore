# ══════════════════════════════════════════════════════════════
# .dockerignore — jangan copy file berat ke build context
# ──────────────────────────────────────────────────────────────
# Build context = root project (lihat docker/docker-compose.yml).
# Pola TANPA awalan "**/" hanya cocok di root context.
#
# Yang di-COPY oleh Dockerfile (JANGAN di-ignore):
#   requirements.txt, backend/, parking-dashboard/,
#   docker/frontend/nginx.conf
# ══════════════════════════════════════════════════════════════

# Python
**/__pycache__/
**/*.py[cod]
.Python
venv/
env/
.venv/
environments/
**/*.egg-info/

# Node
**/node_modules/
parking-dashboard/dist/
**/npm-debug.log*

# Environment lokal (jangan sampai ikut ter-bake ke image)
**/.env
**/.env.local
**/.env.*.local

# Model & media besar — di-mount via volume saat runtime, bukan di-COPY.
# Meng-ignore di sini tidak memengaruhi bind mount di docker-compose.yml.
**/*.pt
**/*.pth
**/*.onnx
*_openvino_model/
**/*.zip
**/*.mp4
**/*.avi
**/*.mov
**/*.mkv
**/*.webm

# Output & upload (di-mount saat runtime)
outputs/
uploads/

# Notebook, script legacy & arsip (bukan bagian runtime)
**/*.ipynb
**/.ipynb_checkpoints/
demo*.py
generate_*.py
backup-backend/
Raspberry Pi/
ColorVechicle/
color_model/
gabungin_vehicle_and_segitiga/
images/
video/
Contoh Thesis/
Dapus Thesis/
Sumber/

# IDE & VCS
.git/
.gitignore
.claude/
.vscode/
.idea/
**/*.swp
**/.DS_Store

# Docs
docs/
**/*.md
LICENSE

# Folder docker/ sengaja TIDAK di-ignore: docker/frontend/Dockerfile
# meng-COPY docker/frontend/nginx.conf dari build context.
